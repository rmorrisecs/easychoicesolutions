Options -Indexes
DirectoryIndex pages/index.html

RewriteEngine On

# Redirect www to non-www (HTTPS)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pretty URLs for main pages
RewriteRule ^about/?$ pages/about.html [L]
RewriteRule ^services/?$ pages/services.html [L]
RewriteRule ^contact/?$ pages/contact.html [L]
RewriteRule ^blog/?$ pages/blog.html [L]
RewriteRule ^home/?$ pages/index.html [L]

# Serve existing files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fallback homepage for unknown paths that are not real files
RewriteRule ^$ pages/index.html [L]

# HTML should revalidate quickly after deploys; versioned assets can cache longer
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
